# Copy to .env and adjust. Every setting uses the KAP_ prefix.
KAP_ENVIRONMENT=local
KAP_CLOUD_PROVIDERS=aws_sim,azure_sim
KAP_ROUTING_STRATEGY=priority
KAP_JWT_SECRET=replace-with-a-long-random-string
KAP_LOCAL_MASTER_KEY=replace-with-another-long-random-string

# AWS (used when KAP_CLOUD_PROVIDERS includes aws)
KAP_AWS_REGION=ap-southeast-2
KAP_AWS_LEDGER_BUCKET=kapconnect-rpr-ledger
KAP_AWS_QUEUE_PREFIX=kapconnect
KAP_AWS_KMS_KEY_ID=
# KAP_AWS_ENDPOINT_URL=http://localhost:4566

# Azure (used when KAP_CLOUD_PROVIDERS includes azure)
KAP_AZURE_REGION=australiaeast
KAP_AZURE_STORAGE_ACCOUNT_URL=
KAP_AZURE_LEDGER_CONTAINER=rpr-ledger
KAP_AZURE_MESSAGING=servicebus
KAP_AZURE_SERVICEBUS_NAMESPACE=
KAP_AZURE_KEYVAULT_KEY_ID=
# KAP_AZURE_STORAGE_CONNECTION_STRING=

# Clinical and FinOps
KAP_ESCALATION_SECONDS=900
KAP_MONTHLY_BUDGET_AUD=500
KAP_PROJECTED_MONTHLY_TESTS=1500000
